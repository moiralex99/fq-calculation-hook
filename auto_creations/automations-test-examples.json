    "name": "Cascade priorité 3 niveaux (Projet > Tâches > Actions)",
    "status": "active",
    "collection_cible": "1_projets"
  },
  {
    "description": "Create random object - Tâche change de statut, créer une notification",
    "trigger_event": "items.update",
    "condition": {
      "!=": [
        {
          "var": "payload.statut"
        },
        {
          "var": "accountability.payload.statut"
        }
      ]
    },
    "actions": [
      {
        "type": "create_item",
        "collection_cible": "directus_notifications",
        "champs": {
          "recipient": {
            "var": "accountability.user"
          },
          "subject": {
            "cat": [
              "Tâche '",
              {
                "var": "payload.titre"
              },
              "' passée en statut ",
              {
                "var": "payload.statut"
              }
            ]
          },
          "message": {
            "cat": [
              "La tâche a changé de statut : ",
              {
                "var": "accountability.payload.statut"
              },
              " → ",
              {
                "var": "payload.statut"
              }
            ]
          },
          "collection": "1_taches",
          "item": {
            "var": "keys[0]"
          }
        }
      }
    ],
    "name": "Créer notification au changement statut tâche",
    "status": "active",
    "collection_cible": "1_taches"
  },
  {
    "description": "Duplication sur 2 niveaux - Dupliquer un projet avec toutes ses phases",
    "trigger_event": "items.create",
    "condition": {
      "==": [
        {
          "var": "payload.code_projet"
        },
        "DUPLICATE"
      ]
    },
    "actions": [
      {
        "type": "for_each",
        "source_collection": "1_phases",
        "filtres": {
          "projet_id": {
            "_eq": {
              "var": "keys[0]"
            }
          }
        },
        "variable_name": "phase",
        "actions": [
          {
            "type": "create_item",
            "collection_cible": "1_phases",
            "champs": {
              "nom": {
                "cat": [
                  {
                    "var": "phase.nom"
                  },
                  " (copie)"
                ]
              },
              "description": {
                "var": "phase.description"
              },
              "ordre": {
                "var": "phase.ordre"
              },
              "projet_id": {
                "var": "keys[0]"
              },
              "statut": "pas_commence",
              "duree_estimee_jours": {
                "var": "phase.duree_estimee_jours"
              }
            }
          }
        ]
      }
    ],
    "name": "Duplication Projet + Phases (LV2)",
    "status": "inactive",
    "collection_cible": "1_projets"
  },
  {
    "description": "Duplication sur 3 niveaux - Dupliquer un projet avec phases et tâches",
    "trigger_event": "items.create",
    "condition": {
      "==": [
        {
          "var": "payload.code_projet"
        },
        "DUPLICATE_FULL"
      ]
    },
    "actions": [
      {
        "type": "for_each",
        "source_collection": "1_phases",
        "filtres": {
          "projet_id": {
            "_eq": {
              "var": "keys[0]"
            }
          }
        },
        "variable_name": "phase",
        "actions": [
          {
            "type": "create_item",
            "collection_cible": "1_phases",
            "champs": {
              "nom": {
                "cat": [
                  {
                    "var": "phase.nom"
                  },
                  " (copie)"
                ]
              },
              "projet_id": {
                "var": "keys[0]"
              },
              "statut": "pas_commence"
            },
            "store_result_as": "new_phase_id"
          },
          {
            "type": "for_each",
            "source_collection": "1_taches",
            "filtres": {
              "phase_id": {
                "_eq": {
                  "var": "phase.id"
                }
              }
            },
            "variable_name": "tache",
            "actions": [
              {
                "type": "create_item",
                "collection_cible": "1_taches",
                "champs": {
                  "titre": {
                    "cat": [
                      {
                        "var": "tache.titre"
                      },
                      " (copie)"
                    ]
                  },
                  "phase_id": {
                    "var": "new_phase_id"
                  },
                  "projet_id": {
                    "var": "keys[0]"
                  },
                  "statut": "a_faire",
                  "priorite": {
                    "var": "tache.priorite"
                  },
                  "type_tache": {
                    "var": "tache.type_tache"
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "name": "Duplication Projet + Phases + Tâches (LV3)",
    "status": "inactive",
    "collection_cible": "1_projets"
  },
  {
    "description": "Assign conditional user 1 - Selon le type de tâche créée, assigner un user différent",
    "trigger_event": "items.create",
    "condition": {
      "in": [
        {
          "var": "payload.type_tache"
        },
        [
          "dev",
          "design",
          "test"
        ]
      ]
    },
    "actions": [
      {
        "type": "update_current",
        "champs": {
          "user_assigned_id": {
            "if": [
              {
                "==": [
                  {
                    "var": "payload.type_tache"
                  },
                  "dev"
                ]
              },
              "user-dev-uuid",
              {
                "==": [
                  {
                    "var": "payload.type_tache"
                  },
                  "design"
                ]
              },
              "user-designer-uuid",
              {
                "==": [
                  {
                    "var": "payload.type_tache"
                  },
                  "test"
                ]
              },
              "user-qa-uuid",
              null
            ]
          }
        }
      }
    ],
    "name": "Assign user selon type tâche",
    "status": "inactive",
    "collection_cible": "1_taches"
  },
  {
    "description": "Assign conditional user 2 - Selon le type de tâche ET le département, assigner le user spécialisé",
    "trigger_event": "items.create",
    "condition": {
      "_and": [
        {
          "in": [
            {
              "var": "payload.type_tache"
            },
            [
              "dev",
              "design"
            ]
          ]
        }
      ]
    },
    "actions": [
      {
        "type": "lookup",
        "collection": "1_projets",
        "key_field": "id",
        "key_value": {
          "var": "payload.projet_id"
        },
        "select_fields": [
          "departement_id"
        ],
        "store_result_as": "projet_info"
      },
      {
        "type": "update_current",
        "champs": {
          "user_assigned_id": {
            "if": [
              {
                "_and": [
                  {
                    "==": [
                      {
                        "var": "payload.type_tache"
                      },
                      "dev"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "projet_info.departement_id"
                      },
                      1
                    ]
                  }
                ]
              },
              "user-dev-it-uuid",
              {
                "_and": [
                  {
                    "==": [
                      {
                        "var": "payload.type_tache"
                      },
                      "design"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "projet_info.departement_id"
                      },
                      2
                    ]
                  }
                ]
              },
              "user-designer-mkt-uuid",
              null
            ]
          }
        }
      }
    ],
    "name": "Assign user selon type tâche ET département",
    "status": "inactive",
    "collection_cible": "1_taches"
  },
  {
