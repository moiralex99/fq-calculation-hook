        },
        "champs": {
          "derniere_tache_maj": {
            "var": "payload.titre"
          },
          "date_derniere_maj": {
            "now": []
          }
        }
      }
    ],
    "name": "Update parent projet (dernière tâche MAJ)",
    "status": "active",
