[
  {
    "name": "Auto date_fin quand projet terminé",
    "description": "Change current item - Mettre date de fin à la date du jour quand le statut passe à Terminé",
    "status": "active",
    "collection_cible": "1_projets",
    "trigger_event": "items.update",
    "condition": {
      "==": [
        {
          "var": "payload.statut"
        },
        "termine"
      ]
    },
    "actions": [
      {
        "type": "update_current",
        "champs": {
          "date_fin": {
            "now": []
          }
        }
      }
    ]
  },
  {
    "description": "Change Childs (M2O) - Héritage du statut (statut projet à terminé ==> taches terminées)",
    "trigger_event": "items.update",
    "condition": {
      "==": [
        {
          "var": "payload.statut"
        },
        "termine"
      ]
    },
    "actions": [
      {
        "type": "update_many",
        "collection_cible": [
          "1_taches"
        ],
        "filtres": {
          "_and": [
            {
              "projet_id": {
                "_eq": {
                  "var": "keys[0]"
                }
              }
            }
          ]
        },
        "champs": {
          "statut": "termine",
          "completed": true
        }
      }
    ],
    "name": "Cascade statut projet vers tâches",
    "status": "active",
    "collection_cible": "1_projets"
  },
  {
    "description": "Change childs level +2 - Héritage de la priorité sur 3 niveaux",
