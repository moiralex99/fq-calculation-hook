  },
  {
    "description": "Change parents level +2 - Actions ==> Tâches ==> Projet - Champ sur le projet (dernière action MAJ)",
    "trigger_event": "items.update",
    "condition": {
      "==": [
        {
          "var": "payload.completed"
        },
        true
      ]
    },
    "actions": [
      {
        "type": "lookup",
        "collection": "1_taches",
        "key_field": "id",
        "key_value": {
          "var": "payload.tache_id"
        },
        "select_fields": [
          "projet_id",
          "titre"
        ],
        "store_result_as": "tache_info"
      },
      {
        "type": "update_item",
        "collection_cible": "1_projets",
        "item_id": {
          "var": "tache_info.projet_id"
        },
        "champs": {
          "derniere_action_completee": {
            "var": "payload.titre"
          },
          "derniere_tache_active": {
            "var": "tache_info.titre"
          },
          "date_derniere_maj": {
            "now": []
          }
        }
      }
    ],
    "name": "Update parent projet level +2 (dernière action MAJ)",
    "status": "active",
    "collection_cible": "1_actions"
  },
  {
    "description": "Calcul automatique de la progression d'une phase basé sur les tâches complétées",
    "trigger_event": "items.update",
    "condition": {
      "!=": [
        {
          "var": "payload.completed"
        },
        {
          "var": "accountability.payload.completed"
        }
      ]
    },
    "actions": [
      {
        "type": "lookup_many",
        "collection": "1_taches",
        "filtres": {
          "phase_id": {
            "_eq": {
              "var": "payload.phase_id"
            }
          }
        },
        "select_fields": [
          "completed"
        ],
        "store_result_as": "all_taches"
      },
      {
        "type": "update_item",
        "collection_cible": "1_phases",
        "item_id": {
          "var": "payload.phase_id"
        },
        "champs": {
          "progression": {
            "*": [
              {
                "/": [
                  {
                    "reduce": [
                      {
                        "var": "all_taches"
                      },
                      {
                        "+": [
                          {
                            "var": "accumulator"
                          },
                          {
                            "if": [
                              {
                                "var": "current.completed"
                              },
                              1,
                              0
                            ]
                          }
                        ]
                      },
                      0
                    ]
                  },
                  {
                    "count": [
                      {
                        "var": "all_taches"
                      }
                    ]
                  }
                ]
              },
              100
            ]
          }
        }
      }
    ],
    "name": "Auto-calcul progression phase",
    "status": "active",
    "collection_cible": "1_taches"
  },
  {
    "description": "Calcul automatique du budget utilisé basé sur les coûts réels des tâches",
    "trigger_event": "items.update",
    "condition": {
      "!=": [
        {
          "var": "payload.cout_reel"
        },
        {
          "var": "accountability.payload.cout_reel"
        }
      ]
    },
    "actions": [
      {
        "type": "lookup_many",
        "collection": "1_taches",
        "filtres": {
          "projet_id": {
            "_eq": {
              "var": "payload.projet_id"
            }
          }
        },
        "select_fields": [
          "cout_reel"
        ],
        "store_result_as": "taches_projet"
      },
      {
        "type": "update_item",
        "collection_cible": "1_projets",
        "item_id": {
          "var": "payload.projet_id"
        },
        "champs": {
          "budget_utilise": {
            "reduce": [
              {
                "var": "taches_projet"
              },
              {
                "+": [
                  {
                    "var": "accumulator"
                  },
                  {
                    "var": "current.cout_reel"
                  }
                ]
              },
              0
            ]
          }
        }
      }
    ],
    "name": "Auto-calcul budget utilisé projet",
    "status": "active",
    "collection_cible": "1_taches"
  },
  {
    "description": "Auto-marker en_retard = true si deadline < NOW() et tâche non complétée",
    "trigger_event": "items.update",
    "condition": {
      "_and": [
        {
          "==": [
            {
              "var": "payload.completed"
            },
            false
          ]
        },
        {
          "!=": [
            {
              "var": "payload.deadline"
            },
            null
          ]
        },
        {
          "<": [
            {
              "var": "payload.deadline"
            },
            {
              "now": []
            }
          ]
        }
      ]
    },
    "actions": [
      {
        "type": "update_current",
        "champs": {
          "en_retard": true,
          "urgent": true
        }
      }
    ],
    "name": "Marquer tâche en retard si deadline dépassée",
    "status": "active",
    "collection_cible": "1_taches"
  },
  {
    "description": "Bloquer toutes les phases si budget_utilise > budget_prevu",
    "trigger_event": "items.update",
    "condition": {
      ">": [
        {
          "var": "payload.budget_utilise"
        },
        {
          "var": "payload.budget_prevu"
        }
      ]
    },
    "actions": [
      {
        "type": "update_many",
        "collection_cible": [
          "1_phases"
        ],
        "filtres": {
          "projet_id": {
            "_eq": {
              "var": "keys[0]"
            }
          }
        },
        "champs": {
          "bloquee": true,
          "statut": "bloque"
        }
      },
      {
        "type": "create_item",
        "collection_cible": "directus_notifications",
        "champs": {
          "recipient": {
            "var": "accountability.user"
          },
          "subject": {
            "cat": [
              "⚠️ Budget dépassé : ",
              {
                "var": "payload.nom"
              }
            ]
          },
          "message": {
            "cat": [
              "Le projet a dépassé son budget prévu (",
              {
                "var": "payload.budget_prevu"
              },
              "€). Budget utilisé : ",
              {
                "var": "payload.budget_utilise"
              },
              "€"
            ]
          }
        }
      }
    ],
    "name": "Bloquer phase si budget projet dépassé",
    "status": "active",
    "collection_cible": "1_projets"
  }
]