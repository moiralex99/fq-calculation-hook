{
  "name": "directus-extension-smart-notifications",
  "version": "1.0.0",
  "description": "Smart Notifications & Alerts for Directus",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-bundle"
  ],
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/index.js",
      "api": "dist/index.js"
    },
    "entries": [
      {
        "type": "hook",
        "name": "smart-notifications-hook",
        "source": "src/hook/index.js"
      },
      {
        "type": "endpoint",
        "name": "smart-notifications",
        "source": "src/endpoint/index.js"
      }
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w",
    "test": "node scripts/test-e2e.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:webhooks": "node scripts/test-webhooks.mjs",
    "test:operation": "node scripts/test-operation.mjs",
    "test:scenario": "node scripts/test-scenario-complet.mjs",
    "test:all": "npm run test:e2e && npm run test:webhooks && npm run test:operation && npm run test:scenario"
  },
  "dependencies": {
    "json-logic-js": "^2.0.2",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^11.0.0"
  }
}
